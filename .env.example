# Local configuration only. No credentials are distributed.
EDGE_BASE_URL=https://edge.example.org/v1
EDGE_API_KEY=
CLOUD_BASE_URL=https://cloud.example.org/v1
CLOUD_API_KEY=
JUDGE_BASE_URL=https://judge.example.org/v1
JUDGE_API_KEY=
JUDGE_MODEL=gpt-5.4-mini
JUDGE_REASONING_EFFORT=medium
SERPER_API_KEY=
SEARCH_PROVIDER=serper
# E2B: use your own template built from the runtime recipe.
E2B_API_KEY=
E2B_TEMPLATE=
E2B_USER=root
# Optional enterprise E2B deployments only; standard templates leave this blank.
E2B_IMAGE=
# Docker alternative: build the runtime image first.
DOCKER_IMAGE=ec2-bench-runtime:review
GLIMPSE_TOP_K=20
# Set after collecting and calibrating entropy logs for your endpoint.
# GLIMPSE_ENTROPY_THRESHOLD=

# Optional cloud token prices (USD per million tokens).
MODEL_PRICING_FILE=
# Optional active-parameter count for the selected edge model; required when unknown.
# For MoE models, supply parameters activated per token, not total parameters.
EDGE_ACTIVE_PARAMETERS=
